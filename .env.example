# Postgres connection string (required).
DATABASE_URL=

# Auth (better-auth). BETTER_AUTH_SECRET falls back to an insecure dev-only
# value if unset — always set a real one in production.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (optional — omit to disable "Sign in with Google").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 32-byte AES-256 key (base64) for encrypting saved-source credentials at
# rest. Generate with: openssl rand -base64 32
SOURCE_ENCRYPTION_KEY=

# Default OpenAI-compatible provider for AI-assisted channel matching and
# portal-text import (optional — users can also set these per-account in
# Settings). AI_MODEL is only used as a fallback when a request doesn't
# specify a model.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Base URL of an EasyProxy instance, used to bypass mixed-content and
# hotlink-protected sources (optional).
NEXT_PUBLIC_PROXY_URL=

# Mux Data environment key for player analytics (optional).
NEXT_PUBLIC_MUX_ENV_KEY=
