dist/
# Anchored to the root on purpose. Unanchored, these match a directory of that
# name at any depth — which quietly swallowed the native source of the local
# module under modules/logo-analysis/android, so it was never committed and CI
# built an app without it.
/android/
/ios/

# The anchoring above has a cost: it also stops ignoring build output under
# modules/*/android, which is how 102 files of Gradle cache ended up committed.
# Named directly so the source stays tracked and the output does not.
modules/*/android/build/
modules/*/android/.gradle/

*.log

