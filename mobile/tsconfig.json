{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ],
      "@portalhop/shared": [
        "../packages/shared/src/index.ts"
      ],
      "@portalhop/shared/*": [
        "../packages/shared/src/*"
      ],
      "@lucide/lab/dist/esm/icons/*": [
        "./types/lab-icon.d.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "uniwind-types.d.ts"
  ]
}
